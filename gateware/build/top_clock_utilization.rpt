# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells system_processing_system7_0_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG]
set_property LOC BUFGCTRL_X0Y2 [get_cells BUFG_3]
set_property LOC BUFGCTRL_X0Y0 [get_cells BUFG_4]
set_property LOC BUFGCTRL_X0Y3 [get_cells linienmodule_decimate_output_BUFG_inst]
set_property LOC BUFGCTRL_X0Y5 [get_cells BUFG_1]
set_property LOC BUFGCTRL_X0Y4 [get_cells BUFG]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y25 [get_ports clk125_n]
set_property LOC IOB_X0Y26 [get_ports clk125_p]

# Clock net "system_processing_system7_0_0/inst/FCLK_CLK0" driven by instance "system_processing_system7_0_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_system_processing_system7_0_0/inst/FCLK_CLK0}
add_cells_to_pblock [get_pblocks  {CLKAG_system_processing_system7_0_0/inst/FCLK_CLK0}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="system_processing_system7_0_0/inst/FCLK_CLK0"}]]]
resize_pblock [get_pblocks {CLKAG_system_processing_system7_0_0/inst/FCLK_CLK0}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "sys_double_clk" driven by instance "BUFG_3" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_sys_double_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_sys_double_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sys_double_clk"}]]]
resize_pblock [get_pblocks {CLKAG_sys_double_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "sys_clk" driven by instance "BUFG_4" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_sys_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_sys_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="sys_clk"}]]]
resize_pblock [get_pblocks {CLKAG_sys_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "linienmodule_decimate_output_BUFG" driven by instance "linienmodule_decimate_output_BUFG_inst" located at site "BUFGCTRL_X0Y3"
#startgroup
create_pblock {CLKAG_linienmodule_decimate_output_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_linienmodule_decimate_output_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="linienmodule_decimate_output_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_linienmodule_decimate_output_BUFG}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup
